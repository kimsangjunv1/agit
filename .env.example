# NextAuth
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3100

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# fivepixels (스테이징 UI 피드백 — project + env 로 데이터 격리)
NEXT_PUBLIC_FIVEPIXELS_PROJECT_ID=agit
NEXT_PUBLIC_FIVEPIXELS_ENV=stage
NEXT_PUBLIC_FIVEPIXELS_VERSION=1.0.0
NEXT_PUBLIC_FIVEPIXELS_USER_ID=local-dev
NEXT_PUBLIC_FIVEPIXELS_USER_NAME=Dev
# 배포된 스테이징에서도 노출하려면 false
NEXT_PUBLIC_FIVEPIXELS_DEV_ONLY=true

# Site (SSR self-fetch, canonical URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
